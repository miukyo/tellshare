# Server settings
PORT=3000
HOST=0.0.0.0
# Optional: leave blank to auto-detect from incoming request (Host / X-Forwarded-*)
BASE_URL=

# Telegram MTProto credentials (from https://my.telegram.org)
API_ID=
API_HASH=

# Optional: Bot token from @BotFather (if omitted, uses user session created by `bun run login`)
BOT_TOKEN=

# Optional in user-account mode: if unset, TellShare auto-creates/reuses a channel named STORAGE_CHANNEL_NAME.
# Required when using BOT_TOKEN (e.g. -1001234567890).
STORAGE_CHAT_ID=
STORAGE_CHANNEL_NAME=tellshare files

# Directory for SQLite metadata database and Telegram session
DATA_DIR=./data

# Upload Limits
MAX_FILE_SIZE=536870912
ALLOW_URL_UPLOAD=true
